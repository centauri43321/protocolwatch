---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StageBadge from '../../components/StageBadge.astro';
import RiskDashboard from '../../components/RiskDashboard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const categories = ['dexes', 'lending', 'liquid-staking', 'bridges', 'derivatives', 'yield', 'privacy'];
  const paths = [];

  for (const category of categories) {
    const protocols = await getCollection(category as any);
    for (const protocol of protocols) {
      paths.push({
        params: {
          category: protocol.data.category,
          slug: protocol.slug
        },
        props: { protocol }
      });
    }
  }

  return paths;
}

type Props = {
  protocol: CollectionEntry<'dexes'> | CollectionEntry<'lending'> | CollectionEntry<'liquid-staking'> | CollectionEntry<'bridges'> | CollectionEntry<'derivatives'> | CollectionEntry<'yield'> | CollectionEntry<'privacy'>;
};

const { protocol } = Astro.props;
const { Content } = await protocol.render();
const { data } = protocol;

const categoryNames: Record<string, string> = {
  'dexes': 'DEXes',
  'lending': 'Lending',
  'liquid-staking': 'Liquid Staking',
  'bridges': 'Bridges',
  'derivatives': 'Derivatives',
  'yield': 'Yield',
  'privacy': 'Privacy',
};

const stageLabels: Record<number, string> = {
  0: 'Fully Assisted',
  1: 'Limited Trust',
  2: 'Trustless',
};

const siteUrl = (Astro.site?.href ?? 'https://protocolwatch.xyz/').replace(/\/$/, '');
const pageUrl = `${siteUrl}/${data.category}/${protocol.slug}/`;
const metaDescription = `${data.name} risk assessment — Stage ${data.stage} (${stageLabels[data.stage]}). Analysis of upgradeability, admin control, fund access, audits, and external dependencies.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: categoryNames[data.category] || data.category, item: `${siteUrl}/${data.category}/` },
      { '@type': 'ListItem', position: 3, name: data.name, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: `${data.name} Risk Assessment`,
    description: metaDescription,
    datePublished: data.lastUpdated,
    dateModified: data.lastUpdated,
    mainEntityOfPage: pageUrl,
    about: { '@type': 'Thing', name: data.name },
    author: { '@type': 'Organization', name: 'ProtocolWatch', url: `${siteUrl}/` },
    publisher: { '@type': 'Organization', name: 'ProtocolWatch', url: `${siteUrl}/` },
  },
];
---

<BaseLayout title={data.name} description={metaDescription} jsonLd={jsonLd}>
  <Breadcrumb items={[
    { label: 'Home', href: '/' },
    { label: categoryNames[data.category] || data.category, href: `/${data.category}` },
    { label: data.name },
  ]} />

  <article>
    <!-- Protocol Header -->
    <div class="mb-8 pb-8 border-b border-border-subtle">
      <div class="flex items-start justify-between gap-4 mb-4 flex-wrap">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight">{data.name}</h1>
        <div class="flex items-center gap-2">
          <StageBadge stage={data.stage} size="lg" />
        </div>
      </div>

      <div class="flex items-center gap-3 flex-wrap mb-4">
        {data.tvl && (
          <div class="flex items-center gap-1.5 px-3 py-1.5 bg-bg-card border border-border-subtle rounded-lg text-sm">
            <span class="text-text-muted">TVL</span>
            <span class="font-semibold text-text-primary">{data.tvl}</span>
          </div>
        )}
        <a
          href={data.website}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 px-3 py-1.5 bg-bg-card border border-border-subtle rounded-lg text-sm
                 text-accent-light hover:border-accent/30 transition-all duration-150"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          {new URL(data.website).hostname}
        </a>
        <div class="flex items-center gap-1.5 px-3 py-1.5 bg-bg-card border border-border-subtle rounded-lg text-sm text-text-muted">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {data.lastUpdated}
        </div>
      </div>

      {data.chains.length > 0 && (
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-xs text-text-muted uppercase tracking-wider font-medium">Chains</span>
          {data.chains.map(chain => (
            <span class="px-2.5 py-1 bg-bg-tertiary/70 border border-border-subtle rounded-lg text-xs capitalize text-text-secondary">
              {chain}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Risk Dashboard -->
    <div class="mb-10">
      <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wider mb-3">Risk Assessment</h2>
      <RiskDashboard risks={data.risks} />
    </div>

    <!-- Markdown Content -->
    <div class="prose-content">
      <Content />
    </div>
  </article>
</BaseLayout>
