---
interface Props {
  dependency: 'none' | 'decentralized' | 'mixed' | 'centralized';
  size?: 'sm' | 'md';
}
const { dependency, size = 'md' } = Astro.props;

const sizeClasses: Record<string, string> = {
  sm: 'text-[10px] gap-1 px-1.5 py-0.5',
  md: 'text-xs gap-1.5 px-3 py-1',
};

const iconSize: Record<string, string> = {
  sm: 'w-2.5 h-2.5',
  md: 'w-3 h-3',
};

const badgeStyles: Record<string, string> = {
  'none': 'bg-stage-2-bg text-stage-2 border-stage-2/30',
  'decentralized': 'bg-stage-2-bg text-stage-2 border-stage-2/30',
  'mixed': 'bg-stage-1-bg text-stage-1 border-stage-1/30',
  'centralized': 'bg-stage-0-bg text-stage-0 border-stage-0/30',
};

const badgeGlow: Record<string, string> = {
  'none': '0 0 8px var(--color-stage-2-glow)',
  'decentralized': '0 0 8px var(--color-stage-2-glow)',
  'mixed': '0 0 8px var(--color-stage-1-glow)',
  'centralized': '0 0 8px var(--color-stage-0-glow)',
};

const badgeLabel: Record<string, string> = {
  'none': 'None',
  'decentralized': 'Decentralized Deps',
  'mixed': 'Mixed Dependencies',
  'centralized': 'Centralized Risk',
};

const badgeTitle: Record<string, string> = {
  'none': 'No external dependencies — fully on-chain',
  'decentralized': 'External dependencies are decentralized and well-constrained',
  'mixed': 'Mix of decentralized and centralized external dependencies',
  'centralized': 'Critical reliance on centralized or unconstrained external systems',
};

// Link icon for none/decentralized, warning for mixed, alert for centralized
const badgeIcon: Record<string, string[]> = {
  'none': [
    'M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71',
    'M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71',
  ],
  'decentralized': [
    'M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71',
    'M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71',
  ],
  'mixed': [
    'M12 9v4',
    'M12 17h.01',
    'M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z',
  ],
  'centralized': [
    'M12 8v4',
    'M12 16h.01',
    'M12 2a10 10 0 100 20 10 10 0 000-20z',
  ],
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full font-semibold border whitespace-nowrap',
    badgeStyles[dependency],
    sizeClasses[size],
  ]}
  style={`box-shadow: ${badgeGlow[dependency]}`}
  title={badgeTitle[dependency]}
>
  <svg class:list={['shrink-0', iconSize[size]]} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    {badgeIcon[dependency].map((d: string) => <path d={d} />)}
  </svg>
  {badgeLabel[dependency]}
</span>
