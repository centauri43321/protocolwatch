---
interface Props {
  stage: number;
  size?: 'sm' | 'md' | 'lg';
}
const { stage, size = 'md' } = Astro.props;

const sizeClasses: Record<string, string> = {
  sm: 'text-xs gap-1',
  md: 'text-sm gap-1.5',
  lg: 'text-base gap-2',
};

const sizePadding: Record<string, string> = {
  sm: 'padding: 0.125rem 0.5rem',
  md: 'padding: 0.375rem 1rem',
  lg: 'padding: 0.375rem 1rem',
};

const stageLabels: Record<number, string> = {
  0: 'Fully Assisted',
  1: 'Limited Trust',
  2: 'Trustless',
};

const stageStyles: Record<number, string> = {
  0: 'bg-stage-0-bg text-stage-0 border-stage-0/30',
  1: 'bg-stage-1-bg text-stage-1 border-stage-1/30',
  2: 'bg-stage-2-bg text-stage-2 border-stage-2/30',
};

const glowStyles: Record<number, string> = {
  0: '0 0 12px var(--color-stage-0-glow)',
  1: '0 0 12px var(--color-stage-1-glow)',
  2: '0 0 12px var(--color-stage-2-glow)',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full font-semibold border whitespace-nowrap',
    sizeClasses[size],
    stageStyles[stage],
  ]}
  style={`${sizePadding[size]}; box-shadow: ${glowStyles[stage]}`}
>
  <span class="w-1.5 h-1.5 rounded-full bg-current opacity-80"></span>
  Stage {stage}
</span>
